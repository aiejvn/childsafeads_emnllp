      "type": "reasoning",
      "position": {
        "x": 2349,
        "y": 182
      },
      "data": {
        "label": "Undisclosed Advertising?",
        "config": {
          "dataType": "custom",
          "question": "Is the commercial nature of this segment left completely undisclosed?",
          "annotations": [],
          "childNodeIds": [],
          "instructions": "Check whether no commercial disclosure is present anywhere available to the viewer -- not in the spoken content, not in the description, and not via a platform paid-promotion label. If there is truly no disclosure anywhere, answer yes. If any disclosure exists (even if it might be inadequate), answer no -- that case is handled by the next check, not this one.",
          "customEnumValues": [
            "yes",
            "no"
          ]
        }
      },
      "measured": {
        "width": 296,
        "height": 93
      }
    },
    {
      "id": "b193bf82-e7f2-4b0b-88a3-08839eff90bb",
      "type": "reasoning",
      "position": {
        "x": 2509,
        "y": 182
      },
      "data": {
        "label": "Inadequate Disclosure?",
        "config": {
          "dataType": "custom",
          "question": "If a disclosure exists, is it inadequate for a child audience?",
          "annotations": [],
          "childNodeIds": [],
          "instructions": "Only relevant if a disclosure exists somewhere (spoken, in the description, or via a platform label) but would be unclear to a child -- buried, in adult jargon, or otherwise not clear and comprehensible. If Undisclosed Advertising was already answered yes (no disclosure exists at all), answer no here -- these two checks are mutually exclusive by taxonomy rule; do not flag both an undisclosed segment as also having an inadequate disclosure.",
          "customEnumValues": [
            "yes",
            "no"
          ]
        }
      },
      "measured": {
        "width": 296,
        "height": 93
      }
    },
    {
