        "label": "Misleading Claim?",
        "config": {
          "dataType": "custom",
          "question": "Does the segment make an unsubstantiated or high-risk claim about the product's characteristics, results, or price?",
          "annotations": [],
          "childNodeIds": [],
          "instructions": "Answer yes if it makes an unsubstantiated or high-risk claim about characteristics, results, or price -- such as a specific number, a comparison, a guarantee, or a health/fitness/skincare/supplement benefit stated as established fact. Answer no for ordinary subjective opinion/puffery with no specific fact attached.",
          "customEnumValues": [
            "yes",
            "no"
          ]
        }
