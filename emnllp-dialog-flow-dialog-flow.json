      "data": {
        "label": "Commercial Type",
        "config": {
          "question": "What commercial type is being promoted in the segment?",
          "instructions": "Classify the segment based on what the buyer receives from the promotion. Choose exactly one label: physical_goods, digital_content_or_services, physical_services, none, or other. Use the content of the segment itself, not the marketing context. If the segment does not clearly promote any identifiable commercial offering, choose none. If it promotes something that does not fit the listed categories, choose other.",
          "annotations": [],
          "dataType": "custom",
          "customEnumValues": [
            "null",
            "physical_goods",
            "digital_content_or_services",
            "physical_services",
            "none",
            "other"
          ],
          "childNodeIds": []
        },
        "prompt": ""
      },
      "measured": {
        "width": 261,
        "height": 93
