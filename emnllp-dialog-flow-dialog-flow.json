        "x": 1957,
        "y": 182
      },
      "data": {
        "label": "Product Categories",
        "config": {
          "question": "Which product categories apply to the segment?",
          "instructions": "Identify all product category labels that fit what is being sold or promoted. Multiple categories may apply. Classify from the segment content itself. If none of the listed categories fit, use other. Return every applicable category label and avoid adding labels that are not supported by the text.",
          "annotations": [],
          "dataType": "custom",
          "customEnumValues": [
            "null",
            "other"
          ],
          "childNodeIds": []
        },
        "prompt": ""
      },
