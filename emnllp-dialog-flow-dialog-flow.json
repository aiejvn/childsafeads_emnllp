      },
      "data": {
        "label": "Direct Exhortation?",
        "config": {
          "dataType": "custom",
          "question": "Does the segment contain a direct appeal for children to buy, or to persuade adults to buy for them?",
          "annotations": [],
          "childNodeIds": [],
          "instructions": "Answer yes if the segment contains a direct appeal for children to buy or to persuade adults to buy. Answer no for a segment that only states where/how to obtain a product without pressuring the viewer to act.",
          "customEnumValues": [
            "yes",
            "no"
          ]
        }
      },
